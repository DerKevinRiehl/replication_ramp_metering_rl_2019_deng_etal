<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- IDM car-following model (Treiber, Hennecke, Helbing 2000) -->
    <!-- T = desired time headway (like Krauss tau) -->
    <!-- delta = acceleration exponent (default 4) -->
    <!-- s0 = minimum gap (jam distance) in meters -->
    <vType id="DEFAULT_VEHTYPE" carFollowModel="IDM"
        accel="2.6" decel="4.5" sigma="0.0"
        length="5.0" minGap="2.5" maxSpeed="33.33"
        tau="1.5" delta="4" stepping="0.25"
        speedDev="0.1" lcCooperative="0.3" lcAssertive="1.0"/>
    <flow type="DEFAULT_VEHTYPE" id="flow_main" begin="0.00" end="7200.00" vehsPerHour="6000.00" departLane="best" departSpeed="avg" from="E_upstream" to="E_main_after"/>
    <flow type="DEFAULT_VEHTYPE" id="flow_ramp" begin="0.00" end="7200.00" vehsPerHour="1000.00" departLane="best" departSpeed="max" color="255,22,0" from="E_ramp" to="E_main_after"/>
</routes>
